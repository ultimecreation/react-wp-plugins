{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/display-posts",
  "version": "0.1.0",
  "title": "Display posts",
  "category": "text",
  "icon": "admin-post",
  "description": "Display display posts",
  "keywords": [
    "display",
    "post"
  ],
  "example": {},
  "supports": {
    "html": false
  },
  "textdomain": "display-posts",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "attributes": {
    "nbOfPosts": {
      "type": "number",
      "default": 5
    },
    "displayFeaturedImage": {
      "type": "boolean",
      "default": false
    },
    "orderBy": {
      "type": "string",
      "default": "date"
    },
    "order": {
      "type": "string",
      "default": "desc"
    },
    "selectedCategories": {
      "type": "array",
      "default": []
    }
  }
}